{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "proposed-daily-read-v1.schema.json",
  "title": "PROPOSED / MOCK-ONLY Dashboard DAILY Read Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "as_of", "freshness", "permission", "status", "data", "limitations", "provenance", "error"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "request_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": ["string", "null"] },
    "freshness": { "enum": ["FRESH", "STALE", "UNKNOWN"] },
    "permission": { "enum": ["GRANTED", "DENIED", "UNKNOWN"] },
    "status": { "enum": ["OK", "EMPTY", "ERROR", "PENDING"] },
    "data": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/daily_data" }, { "$ref": "#/$defs/trend_data" }] },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "provenance": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" } },
    "error": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/safe_error" }] }
  },
  "$defs": {
    "safe_error": { "type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" } } },
    "metric": { "type": "object", "additionalProperties": false, "required": ["metric_id", "value", "availability", "provenance_ref"], "properties": { "metric_id": { "enum": ["completed_service_count", "lifecycle_opportunity_count", "open_attention_count", "objective_safeguard_count", "unresolved_queue_count", "disputed_queue_count", "blocked_queue_count", "incomplete_queue_count", "camera_event_count", "device_event_count"] }, "value": { "type": ["integer", "null"], "minimum": 0 }, "availability": { "enum": ["AVAILABLE", "UNAVAILABLE"] }, "provenance_ref": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._:-]+$" } } },
    "daily_data": { "type": "object", "additionalProperties": false, "required": ["kind", "surface_ref", "operating_day_id", "completeness", "metrics"], "properties": { "kind": { "const": "DAILY_SURFACE" }, "surface_ref": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" }, "operating_day_id": { "type": "string", "minLength": 1 }, "completeness": { "enum": ["COMPLETE", "PARTIAL", "DEGRADED"] }, "metrics": { "type": "array", "items": { "$ref": "#/$defs/metric" } } } },
    "trend_data": { "type": "object", "additionalProperties": false, "required": ["kind", "artifact_ref", "trend_window", "metrics"], "properties": { "kind": { "const": "TREND_ARTIFACT" }, "artifact_ref": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" }, "trend_window": { "enum": ["7d", "30d"] }, "metrics": { "type": "array", "items": { "$ref": "#/$defs/metric" } } } }
  }
}
