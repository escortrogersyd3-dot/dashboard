{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "proposed-daily-observation-v1.schema.json",
  "title": "PROPOSED / MOCK-ONLY Dashboard DAILY Observation Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "as_of", "freshness", "permission", "status", "data", "limitations", "provenance", "error"],
  "properties": {
    "schema_version": { "const": "1.0" }, "request_id": { "type": "string", "minLength": 1 }, "as_of": { "type": ["string", "null"] },
    "freshness": { "enum": ["FRESH", "STALE", "UNKNOWN"] }, "permission": { "enum": ["GRANTED", "DENIED", "UNKNOWN"] }, "status": { "enum": ["OK", "EMPTY", "ERROR", "PENDING"] },
    "data": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/observation_data" }] }, "limitations": { "type": "array", "items": { "type": "string" } },
    "provenance": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" } }, "error": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/safe_error" }] }
  },
  "$defs": {
    "safe_error": { "type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" } } },
    "slot": { "type": "object", "additionalProperties": false, "required": ["slot_ref", "availability", "authorization_ref", "expires_at", "provenance_ref"], "properties": { "slot_ref": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" }, "availability": { "enum": ["AVAILABLE", "UNAVAILABLE", "UNKNOWN"] }, "authorization_ref": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._:-]+$" }, "expires_at": { "type": ["string", "null"] }, "provenance_ref": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._:-]+$" } } },
    "observation_data": { "type": "object", "additionalProperties": false, "required": ["kind", "surface_ref", "completeness", "slots"], "properties": { "kind": { "const": "DAILY_OBSERVATION" }, "surface_ref": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" }, "completeness": { "enum": ["COMPLETE", "PARTIAL", "DEGRADED"] }, "slots": { "type": "array", "items": { "$ref": "#/$defs/slot" } } } }
  }
}
